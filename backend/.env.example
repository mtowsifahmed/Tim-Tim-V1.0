# --- Supabase (Project Settings → API / Database) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key            # only used to ask Supabase "who owns this token?"
SUPABASE_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Only for OLD Supabase projects that sign logins with a shared secret (Project Settings -> JWT). New projects don't need it.
SUPABASE_JWT_SECRET=

# --- Secrets (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ---
KEY_ENCRYPTION_SECRET=

# --- Limits ---
FREE_DAILY_CAP=30
PRO_ROTATION_DAILY_CAP=100     # Pro users who have NOT added their own key for a capability

# --- Free-tier provider keys (leave blank to skip a provider) ---
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Cloudflare Workers AI: 10,000 free neurons every day. Needs BOTH values (the account id is part of the URL).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Custom gateways (any OpenAI-compatible endpoint, one per capability) ---
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_STT_BASE_URL=
CUSTOM_STT_API_KEY=
CUSTOM_STT_MODEL=
CUSTOM_TTS_BASE_URL=
CUSTOM_TTS_API_KEY=
CUSTOM_TTS_MODEL=
CUSTOM_TTS_VOICE=
CUSTOM_TTS_VOICE_MALE=
CUSTOM_TTS_VOICE_FEMALE=
CUSTOM_EMBED_BASE_URL=
CUSTOM_EMBED_API_KEY=
CUSTOM_EMBED_MODEL=

# --- Optional tuning ---
# Pick a specific model for a provider (otherwise a built-in list is tried in order and retired models are skipped automatically):
# GEMINI_MODEL=gemini-3.5-flash
# One Gemini key also covers voice, so these have their own names (GEMINI_MODEL alone would override chat):
# GEMINI_STT_MODEL=gemini-3.5-transcribe
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# CLOUDFLARE_STT_MODEL=@cf/openai/whisper-large-v3-turbo
# CLOUDFLARE_TTS_MODEL=@cf/myshell-ai/melotts
# GROQ_MODEL=llama-3.3-70b-versatile
# auto = ask the AI to route only action-like requests (saves free quota) | llm = always | keyword = never
ORCHESTRATOR_MODE=auto

# --- Live web search (optional keys; search works without them using free keyless sources) ---
# Free, no card, 1,000 searches a month: https://tavily.com
# This one is the OWNER's key: only accounts with the owner role use it. Every other account can save its own
# key in Settings -> Live web; it is stored encrypted and never sent back to any client.
TAVILY_API_KEY=
# Optional (may ask for a card): https://api.search.brave.com
BRAVE_API_KEY=

# --- Identity and speed (all optional) ---
# Who Tim-Tim says made it when asked:
COMPANY_NAME=Zaftan Studios
# Fastest providers first. Comma-separated names; change the order if you prefer voice quality over speed:
# LLM_PRIORITY=groq,cerebras,gemini,sambanova,openrouter,mistral,nvidia,custom
# STT_PRIORITY=groq-whisper,deepgram,cloudflare-whisper,elevenlabs-scribe,gemini-stt,custom
# TTS_PRIORITY=deepgram-aura,groq-tts,elevenlabs,cloudflare-voice,gemini-tts,custom,edge-tts
