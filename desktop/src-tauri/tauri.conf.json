{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tim-Tim",
  "version": "1.0.0",
  "identifier": "app.timtim.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Tim-Tim",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      },
      {
        "label": "orb",
        "url": "orb.html",
        "title": "Tim-Tim orb",
        "width": 200,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws: wss: http: https:; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Zaftan Studios",
    "copyright": "\u00a9 Zaftan Studios",
    "category": "Productivity",
    "shortDescription": "Tim-Tim, your agentic AI companion",
    "longDescription": "Talk to Tim-Tim, give it tasks, get live answers. Computer actions always ask first.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
